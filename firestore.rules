rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Health check test connection collection
    match /test/{docId} {
      allow read, write: if true;
    }

    // Allow months collection group query for inspection and multi-device sync
    match /{path=**}/months/{monthId} {
      allow read, write: if true;
    }

    // User profile
    match /users/{userId} {
      allow read, write: if isValidId(userId);

      // Monthly financial data subcollection
      match /months/{monthYear} {
        allow read, write: if isValidId(monthYear);
      }

      // Settings and deletions subcollection
      match /settings/{settingId} {
        allow read, write: if isValidId(settingId);
      }
    }

    // Direct multi-device synchronized workspaces
    match /workspaces/{workspaceId} {
      allow read, write: if isValidId(workspaceId);

      match /months/{monthYear} {
        allow read, write: if isValidId(workspaceId) && isValidId(monthYear);
      }

      match /settings/{settingId} {
        allow read, write: if isValidId(workspaceId) && isValidId(settingId);
      }
    }
  }
}
