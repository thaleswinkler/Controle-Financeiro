rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Health check test connection collection
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profile
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // Monthly financial data subcollection
      match /months/{monthYear} {
        allow read: if isOwner(userId) && isValidId(monthYear);
        allow create, update: if isOwner(userId) && isValidId(monthYear);
        allow delete: if isOwner(userId) && isValidId(monthYear);
      }
    }

    // Direct multi-device synchronized workspaces
    match /workspaces/{workspaceId} {
      allow read, write: if isValidId(workspaceId);

      match /months/{monthYear} {
        allow read, write: if isValidId(workspaceId) && isValidId(monthYear);
      }
    }
  }
}
